{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"],
      "@dto/*": ["./src/dto/*"],
      "@interface/*": ["./src/interfaces/*"],
      "@use-case/*": ["./src/use-cases/*"],
      "@repository/*": ["./src/repository/*"],
      "@event/*": ["./src/events/*"]
    }
  },
  "include": ["src"]
}
